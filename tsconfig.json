{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "noEmit": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "sourceMap": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "baseUrl": ".",
    "types": [
      "vite/client",
    ],
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "removeComments": false
  },
  "include": [
    "src",
    "types",
    "src/util",
    "histoire/**/*.ts",
    "*.config.ts",
    "./components.d.ts",
    "./env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "platforms"
  ],
  "vueCompilerOptions": {
    "target": 3,
    "plugins": [
      "@vue/language-plugin-pug"
    ]
  }
}
